# Local dev: run `pnpm db` (a real Postgres on localhost:5433, data in ./.postgres), then:
DATABASE_URL=postgres://postgres:postgres@localhost:5433/auditor
# When deployed, use your Neon (or any Postgres) connection string instead.

# Better Auth: generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Claude API key (https://platform.claude.com). Leave unset if you use `ant auth login`.
ANTHROPIC_API_KEY=
# Model used for diagnosis. Haiku for dev + evals; compare sonnet/opus on the evals later.
AUDIT_MODEL=claude-haiku-5-5
AUDIT_EFFORT=medium

# PageSpeed Insights API key (free): https://developers.google.com/speed/docs/insights/v5/get-started
# Works without a key but is heavily rate-limited.
PAGESPEED_API_KEY=
